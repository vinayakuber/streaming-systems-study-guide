direction: down

S: {
  label: |md
    **1. Watermark propagation**

    estimates flow through the graph
  |
  shape: rectangle
  style: {
    fill: "#238636"
    stroke: "#2ea043"
    font-color: "#FFFFFF"
    border-radius: 8
    font-size: 16
  }
}

A: {
  label: |md
    **2. Downstream = min of upstream**

    a stage cannot be more complete than its inputs
  |
  shape: rectangle
  style: {
    fill: "#8250df"
    stroke: "#8250df"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

B: {
  label: |md
    **3. Updates cascade**

    a source advancing advances its dependents
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. Correctness**

    a wrong propagated watermark mis-times every downstream emission
  |
  shape: rectangle
  style: {
    fill: "#d29922"
    stroke: "#d29922"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. the rule"
A -> B: "2. so"
B -> C: "3. and"
