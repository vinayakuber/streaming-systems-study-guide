    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

B: {
  label: |md
    **3. The fix**

    at-least-once delivery plus deduplication
  |
  shape: rectangle
  style: {
    fill: "#8250df"
    stroke: "#8250df"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. The guarantee**

    exactly-once = at-least-once + at-most-once
  |
  shape: rectangle
  style: {
    fill: "#b62324"
    stroke: "#da3633"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. which produce"
A -> B: "2. so"
B -> C: "3. giving"
