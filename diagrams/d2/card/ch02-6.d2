direction: down

S: {
  label: |md
    **1. How = accumulation**

    how a new pane relates to the prior one
  |
  shape: rectangle
  style: {
    fill: "#238636"
    stroke: "#2ea043"
    font-color: "#FFFFFF"
    border-radius: 8
    font-size: 16
  }
}

A: {
  label: |md
    **2. Discarding**

    each pane independent
  |
  shape: rectangle
  style: {
    fill: "#8250df"
    stroke: "#8250df"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

B: {
  label: |md
    **3. Accumulating**

    running total grows
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. Accumulating + retracting**

    running total plus a retraction of the old value
  |
  shape: rectangle
  style: {
    fill: "#d29922"
    stroke: "#d29922"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. mode"
A -> B: "2. next mode"
B -> C: "3. exact mode"
