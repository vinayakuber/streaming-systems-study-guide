direction: down

S: {
  label: |md
    **1. TUMBLE**

    fixed, non-overlapping windows
  |
  shape: rectangle
  style: {
    fill: "#238636"
    stroke: "#2ea043"
    font-color: "#FFFFFF"
    border-radius: 8
    font-size: 16
  }
}

A: {
  label: |md
    **2. HOP**

    sliding - fixed size, fixed period
  |
  shape: rectangle
  style: {
    fill: "#8250df"
    stroke: "#8250df"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

B: {
  label: |md
    **3. SESSION**

    activity-bounded, merging
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. All emit on the watermark**

    when the window's end passes
  |
  shape: rectangle
  style: {
    fill: "#d29922"
    stroke: "#d29922"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. then"
A -> B: "2. then"
B -> C: "3. each"
