  }
}

B: {
  label: |md
    **3. After emission**

    already-emitted panes must be corrected
  |
  shape: rectangle
  style: {
    fill: "#d29922"
    stroke: "#d29922"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. Via retraction**

    cancel the old, emit the merged
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. so"
A -> B: "2. even"
B -> C: "3. handled"
