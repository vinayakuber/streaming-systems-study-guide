direction: down

S: {
  label: |md
    **1. Watermark passed**

    the window is declared complete
  |
  shape: rectangle
  style: {
    fill: "#238636"
    stroke: "#2ea043"
    font-color: "#FFFFFF"
    border-radius: 8
    font-size: 16
  }
}

A: {
  label: |md
    **2. Allowed lateness**

    a grace period for stragglers
  |
  shape: rectangle
  style: {
    fill: "#8250df"
    stroke: "#8250df"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

B: {
  label: |md
    **3. Late data re-fires**

    each straggler triggers an update or retraction
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

C: {
  label: |md
    **4. The combination**

    watermark = when to close; allowed lateness = how long to forgive
  |
  shape: rectangle
  style: {
    fill: "#d29922"
    stroke: "#d29922"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 16
  }
}

S -> A: "1. then"
A -> B: "2. during which"
B -> C: "3. together"
