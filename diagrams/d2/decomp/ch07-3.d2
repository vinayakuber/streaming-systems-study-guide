    border-radius: 6
    font-size: 15
  }
}

P1: {
  label: |md
    it survives the processor's crash
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

P2: {
  label: |md
    restart reads it back to resume
  |
  shape: rectangle
  style: {
    fill: "#1f6feb"
    stroke: "#388bfd"
    font-color: "#FFFFFF"
    border-radius: 6
    font-size: 15
  }
}

R -> P0: "1. comprises"
R -> P1: "2. comprises"
R -> P2: "3. comprises"
